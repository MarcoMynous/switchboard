{
  "name": "switchboard",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "docker:up": "docker compose up -d --build --wait",
    "docker:down": "docker compose down",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:int": "turbo run test:int --concurrency=1",
    "test:e2e": "pnpm --filter @switchboard/web test:e2e",
    "coverage:check": "turbo run coverage:check",
    "knip": "knip",
    "db:migrate": "pnpm --filter @switchboard/db migrate",
    "db:generate": "pnpm --filter @switchboard/db generate",
    "db:seed": "pnpm --filter @switchboard/db seed"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "26.6.6",
    "knip": "6.44.1",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@neon/config": "1.11.3",
    "@neon/env": "1.6.15"
  }
}
