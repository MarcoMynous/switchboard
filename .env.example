# ─── LOCAL DOCKER VALUES ───────────────────────────────────────────
# Copy to .env. These point at Docker services only.
# Preview/production values live in Vercel env (never in this file).

NODE_ENV=development

# Host port for the postgres container (compose only). Change if 5432 is already taken.
POSTGRES_HOST_PORT=5432

# Database (docker: postgres)
DATABASE_URL=postgres://switchboard:switchboard@postgres:5432/switchboard
DATABASE_URL_UNPOOLED=postgres://switchboard:switchboard@postgres:5432/switchboard

# Apps
API_ORIGIN=http://api:4000
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# Auth
BETTER_AUTH_SECRET=local-dev-secret-change-me-32-characters-min
BETTER_AUTH_URL=http://localhost:3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Switchboard <no-reply@switchboard.ng>"

# Kora (docker: mock-kora). Preview/prod: https://api.korapay.com/merchant + sandbox keys
KORA_BASE_URL=http://mock-kora:4010/merchant
KORA_SECRET_KEY=sk_test_local_mock
KORA_PUBLIC_KEY=pk_test_local_mock

# WhatsApp (docker: stub inside mock-kora). Preview/prod: https://graph.facebook.com/v<version>
WA_API_BASE_URL=http://mock-kora:4010/_wa
WA_PHONE_NUMBER_ID=000000000000000
WA_ACCESS_TOKEN=local-dummy
WA_APP_SECRET=local-dummy-app-secret
WA_VERIFY_TOKEN=local-verify

# Inngest (docker: dev server)
INNGEST_DEV=1
INNGEST_BASE_URL=http://inngest:8288

# LLM — set LLM_PROVIDER=mock to run fully offline
LLM_PROVIDER=mock
LLM_MODEL=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=

# Booking engine
HOLD_MINUTES=15
MIN_LEAD_MINUTES=30
SLOT_STEP_MINUTES=15

# Chaos dashboard
CHAOS_TOKEN=local-chaos
