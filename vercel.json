{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "API_ORIGIN"
        }
      ]
    },
    "api": {
      "root": "apps/api",
      "framework": "hono",
      "entrypoint": "src/index.ts",
      "bindings": [
        {
          "type": "service",
          "service": "mock-kora",
          "format": "url",
          "env": "MOCK_KORA_URL"
        }
      ]
    },
    "mock-kora": {
      "root": "apps/mock-kora",
      "framework": "hono",
      "entrypoint": "src/index.ts"
    }
  },
  "rewrites": [
    {
      "source": "/api/auth/(.*)",
      "destination": {
        "service": "web"
      }
    },
    {
      "source": "/api/workspace",
      "destination": {
        "service": "web"
      }
    },
    {
      "source": "/api/workspace/(.*)",
      "destination": {
        "service": "web"
      }
    },
    {
      "source": "/webhooks/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
