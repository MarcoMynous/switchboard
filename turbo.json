{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "SKIP_ENV_VALIDATION",
    "LHCI_BASE_URL",
    "E2E_BASE_URL",
    "VERCEL_AUTOMATION_BYPASS_SECRET",
    "POSTGRES_HOST_PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": [
        "NODE_ENV",
        "API_ORIGIN",
        "API_URL",
        "PUBLIC_APP_URL",
        "PUBLIC_API_URL",
        "BETTER_AUTH_URL",
        "NEXT_PUBLIC_*",
        "VERCEL",
        "VERCEL_ENV",
        "VERCEL_URL",
        "VERCEL_BRANCH_URL",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "VERCEL_REGION"
      ],
      "passThroughEnv": [
        "BETTER_AUTH_SECRET",
        "AUTH_SECRET",
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "NEON_BRANCH",
        "NEON_AUTH_BASE_URL",
        "NEON_AUTH_JWKS_URL",
        "NEON_AUTH_COOKIE_SECRET",
        "KORA_BASE_URL",
        "KORA_SECRET_KEY",
        "KORA_PUBLIC_KEY",
        "MOCK_KORA_URL",
        "WEBHOOK_TARGET",
        "WA_WEBHOOK_TARGET",
        "WA_API_BASE_URL",
        "WA_PHONE_NUMBER_ID",
        "WA_ACCESS_TOKEN",
        "WA_APP_SECRET",
        "WA_VERIFY_TOKEN",
        "INNGEST_DEV",
        "INNGEST_BASE_URL",
        "INNGEST_EVENT_KEY",
        "INNGEST_SIGNING_KEY",
        "LLM_PROVIDER",
        "LLM_MODEL",
        "ANTHROPIC_API_KEY",
        "GOOGLE_GENERATIVE_AI_API_KEY",
        "GROQ_API_KEY",
        "HOLD_MINUTES",
        "MIN_LEAD_MINUTES",
        "SLOT_STEP_MINUTES",
        "CHAOS_TOKEN",
        "PORT"
      ]
    },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "outputs": ["coverage/**"] },
    "test:int": { "cache": false, "passThroughEnv": ["DATABASE_URL", "DATABASE_URL_UNPOOLED"] },
    "coverage:check": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "DATABASE_URL_UNPOOLED"]
    },
    "dev": { "cache": false, "persistent": true }
  }
}
